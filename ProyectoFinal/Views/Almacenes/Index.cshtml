@model IReadOnlyList<ProyectoFinal.Models.AlmacenAdminRowViewModel>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Almacenes";
}
<div class="page-heading-row"><div><h1>Almacenes</h1><p class="intro">Administra ubicaciones de inventario sin asociarlas a sedes.</p></div><a class="btn btn-primary" asp-action="Create">Nuevo almacén</a></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Almacén</th><th>Estado</th><th>Corte inicial</th><th>Existencias</th><th>Trabajos pendientes</th><th></th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><th>@item.Nombre@(item.EsPredeterminado ? " · Predeterminado" : "")</th><td>@(item.Activo ? "Activo" : "Inactivo")</td><td>@(item.CorteInicialAplicado ? "Registrado" : "Pendiente")</td><td>@item.SaldosConExistencia</td><td>@(item.TieneTrabajoPendiente ? "Sí" : "No")</td><td class="text-nowrap">
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
        @if (!item.EsPredeterminado) { <form asp-action="CambiarEstado" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(item.Activo ? "Desactivar" : "Activar")</button></form> }
    </td></tr>
}
</tbody></table></div>
