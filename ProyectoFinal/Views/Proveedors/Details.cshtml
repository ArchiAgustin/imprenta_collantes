@model ProyectoFinal.Models.Proveedor

@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Detalle de proveedor";
}

<h1>Detalle de proveedor</h1>

<div>
    <h4>Proveedor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contacto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contacto)
        </dd>
    </dl>
</div>
<div class="page-actions">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.IdProveedor">Editar proveedor</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver a proveedores</a>
</div>
