@model ProyectoFinal.Models.Proveedor
@{ Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml"; ViewData["Title"] = "Nuevo proveedor"; }
<h1>Nuevo proveedor</h1>
<p class="intro">Registra su documento de identidad, dirección y distrito.</p>
<form asp-action="Create" method="post" class="identity-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_ProveedorFormFields" model="Model" />
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Guardar proveedor</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/identidad-form.js" asp-append-version="true"></script> }
