@model ProyectoFinal.Models.Proveedor
@{ Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml"; ViewData["Title"] = "Editar proveedor"; }
<h1>Editar proveedor</h1>
<p class="intro">Completa RUC, dirección y ubicación para mantener vigente la ficha del proveedor.</p>
<form asp-action="Edit" method="post" class="identity-form">
    <input type="hidden" asp-for="IdProveedor" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_ProveedorFormFields" model="Model" />
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cambios</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/identidad-form.js" asp-append-version="true"></script> }
