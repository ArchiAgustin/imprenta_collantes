@model ProyectoFinal.Models.Proveedor

@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Eliminar proveedor";
}

<h1>Eliminar proveedor</h1>

<p class="intro">¿Seguro que deseas eliminar este proveedor? Esta acción no se puede deshacer.</p>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div>
    <h4>Proveedor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contacto)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contacto)
        </dd>
        <dt class="col-sm-2">Documento</dt><dd class="col-sm-10">@(Model.DocumentoIdentidadTipo?.Abreviatura ?? "Sin documento") @(Model.NumeroDocumento ?? Model.Ruc ?? "")</dd>
    </dl>
    
    <form asp-action="Delete" method="post" class="page-actions">
        <input type="hidden" asp-for="IdProveedor" />
        <button type="submit" class="btn btn-danger">Eliminar proveedor</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar y volver</a>
    </form>
</div>
