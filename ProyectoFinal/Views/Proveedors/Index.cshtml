@model IEnumerable<ProyectoFinal.Models.Proveedor>

@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Proveedores";
}

<div class="page-heading-row"><div><h1>Proveedores</h1><p class="intro">Directorio de proveedores y datos de contacto.</p></div><a class="btn btn-primary" asp-action="Create">Nuevo proveedor</a></div>
<form asp-action="Index" method="get" class="identity-form search-filters" aria-label="Buscar proveedores">
    <div class="identity-form-grid">
        <div class="form-group"><label for="nombre">Nombre / razón social</label><input id="nombre" name="nombre" value="@ViewBag.NombreFiltro" class="form-control" /></div>
        <div class="form-group"><label for="documento">Documento</label><input id="documento" name="documento" value="@ViewBag.DocumentoFiltro" class="form-control" /></div>
        <div class="form-group"><label for="contacto">Contacto</label><input id="contacto" name="contacto" value="@ViewBag.ContactoFiltro" class="form-control" /></div>
    </div>
    <div class="page-actions"><button type="submit" class="btn btn-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<p class="auth-footnote" role="status">@ViewBag.TotalProveedores resultado(s)</p>
@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>@(ViewBag.TotalProveedores == 0 && (ViewBag.NombreFiltro is not null || ViewBag.DocumentoFiltro is not null || ViewBag.ContactoFiltro is not null) ? "No hay proveedores que coincidan con la búsqueda." : "Aún no hay proveedores registrados.")</strong><p>@(ViewBag.TotalProveedores == 0 ? "Ajusta los filtros o registra un proveedor." : "Empieza creando el primer registro.")</p></div>
}
else
{
<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contacto)
            </th>
            <th>Documento</th><th>Dirección</th><th>Ubigeo</th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Contacto)
            </td>
            <td>@(item.DocumentoIdentidadTipo?.Abreviatura ?? "Sin documento") @(item.NumeroDocumento ?? item.Ruc ?? "")</td><td>@(item.Direccion ?? "Pendiente")</td><td>@(item.Ubigeo?.Descripcion ?? "Pendiente")</td>
            <td>
                <div class="table-actions">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdProveedor">Editar</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdProveedor">Ver</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdProveedor">Eliminar</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
}
@if ((int)ViewBag.Paginas > 1)
{
    <nav class="page-actions" aria-label="Paginación de proveedores">
        <span>Página @ViewBag.Pagina de @ViewBag.Paginas</span>
        @if ((int)ViewBag.Pagina > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-nombre="@ViewBag.NombreFiltro" asp-route-documento="@ViewBag.DocumentoFiltro" asp-route-contacto="@ViewBag.ContactoFiltro" asp-route-pagina="@((int)ViewBag.Pagina - 1)">Anterior</a> }
        @if ((int)ViewBag.Pagina < (int)ViewBag.Paginas) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-nombre="@ViewBag.NombreFiltro" asp-route-documento="@ViewBag.DocumentoFiltro" asp-route-contacto="@ViewBag.ContactoFiltro" asp-route-pagina="@((int)ViewBag.Pagina + 1)">Siguiente</a> }
    </nav>
}
