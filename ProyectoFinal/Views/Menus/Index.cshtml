@model IReadOnlyList<ProyectoFinal.Models.MenuAdminItemViewModel>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Menús del sistema";
}
<div class="page-heading-row">
    <div><h1>Menús del sistema</h1><p class="intro">Organiza la navegación hasta tres niveles. Crear un menú no concede permisos ni inventa una pantalla.</p></div>
    <a class="btn btn-primary" asp-action="Create">Nuevo menú</a>
</div>
<p class="auth-footnote">Los destinos se eligen de una lista segura de pantallas ya registradas. Los agrupadores ordenan el árbol; cada acceso se concede por separado en Permisos por rol.</p>
@if (Model.Count == 0)
{
    <div class="empty-state" role="status"><strong>El catálogo está vacío.</strong><p>Crea un agrupador o vincula una pantalla disponible.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle menu-admin-table">
            <thead><tr><th scope="col">Menú</th><th scope="col">Código</th><th scope="col">Destino</th><th scope="col">Orden</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row"><span class="menu-tree-label" style="--menu-depth:@item.Profundidad">@item.Nombre</span>@if (item.TieneHijosActivos) { <span class="text-muted">· agrupador</span> }</th>
                    <td><code>@item.Codigo</code></td>
                    <td>@(item.DestinoNombre ?? "Solo agrupa; sin enlace")</td>
                    <td>@item.Orden</td>
                    <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                    <td class="user-actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <form asp-action="CambiarEstado" method="post" class="inline-action-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-primary")" type="submit" disabled="@(item.Activo && item.TieneHijosActivos)">@((item.Activo) ? "Desactivar" : "Activar")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
