@model IReadOnlyList<ProyectoFinal.Models.Venta>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Ventas";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-PE");
}

<h1>Ventas</h1>
<p class="intro">Ventas confirmadas desde cotizaciones; cada venta genera un trabajo asociado para taller.</p>

@if (Model.Count == 0)
{
    <div class="empty-state" role="status"><strong>Aún no hay ventas.</strong><p>Confirma una cotización vigente para registrar la primera venta.</p></div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Venta</th><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Trabajo</th><th>Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var sale in Model)
        {
            <tr>
                <th scope="row">@sale.NumeroInterno</th>
                <td>@ProyectoFinal.Services.FechaComercial.EnPeru(sale.FechaVentaUtc).ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(sale.Cliente?.Nombre ?? "Cliente no disponible")</td>
                <td>@sale.Estado</td>
                <td>@(sale.Pedido is null ? "Sin trabajo" : $"#{sale.Pedido.IdPedido} · {sale.Pedido.EstadoPedido}")</td>
                <td>@sale.Total.ToString("C2", culture)</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@sale.IdVenta">Ver</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
