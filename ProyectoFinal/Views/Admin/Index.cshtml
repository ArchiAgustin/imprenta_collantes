@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Lista de usuarios";
}

<h1>Usuarios</h1>
<p>Solo quienes tengan el rol Admin pueden acceder a los módulos de gestión.</p>

<div class="table-responsive"><table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <a asp-action="AssignRole" asp-route-userId="@user.Id">Asignar rol</a>
                </td>
            </tr>
        }
    </tbody>
</table></div>

<a asp-action="CreateRole" class="btn btn-primary">Crear Rol</a>
