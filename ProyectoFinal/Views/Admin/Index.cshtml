@model IEnumerable<ProyectoFinal.Models.UsuarioAdminListViewModel>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Usuarios";
}

<div class="page-heading-row">
    <div>
        <h1>Usuarios</h1>
        <p class="intro">Consulta las cuentas y administra sus roles sin perder asignaciones existentes.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>No hay cuentas registradas.</strong><p>Las cuentas nuevas aparecerán aquí.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th scope="col">Correo</th><th scope="col">Roles asignados</th><th scope="col">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="user-email">@user.Correo</td>
                        <td>
                            @if (user.Roles.Count == 0)
                            {
                                <span class="role-badge role-unassigned">Sin rol</span>
                            }
                            else
                            {
                                <div class="role-badge-list">
                                    @foreach (var role in user.Roles.OrderBy(name => name))
                                    {
                                        <span class="role-badge">@role</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="AssignRole" asp-route-userId="@user.Id">Administrar roles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Usuario/Panel">Volver al panel</a>
    <a class="btn btn-outline-primary" asp-controller="Roles" asp-action="Index">Ir a roles</a>
</div>
