@model ProyectoFinal.Models.AssignRoleViewModel
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Asignar Rol";
}

<h2>Asignar rol a @Model.UserName</h2>

<form asp-action="AssignRole" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label>Seleccionar Rol</label>
        <select asp-for="SelectedRole" asp-items="@(new SelectList(Model.AvailableRoles))" class="form-control"></select>
    </div>

    <button type="submit" class="btn btn-primary">Asignar</button>
</form>
