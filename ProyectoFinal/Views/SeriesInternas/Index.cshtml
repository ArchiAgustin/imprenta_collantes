@model IReadOnlyList<ProyectoFinal.Models.SerieDocumentoInterno>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Series internas";
}
<div class="page-heading-row"><div><h1>Series internas</h1><p class="intro">Define cómo se numeran las próximas cotizaciones y ventas de control interno.</p></div><a class="btn btn-primary" asp-action="Create">Nueva serie</a></div>
<p class="auth-footnote">La serie activa se usa al emitir. Cambiarla no altera documentos anteriores. Los números internos no son series ni comprobantes SUNAT.</p>
@if (Model.Count == 0)
{ <div class="empty-state" role="status">No hay series configuradas. Crea y activa una para cada tipo de documento antes de emitir.</div> }
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th scope="col">Documento</th><th scope="col">Serie</th><th scope="col">Próximo número</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>
    @foreach (var item in Model)
    { <tr><th scope="row">@(item.TipoDocumento == "Cotizacion" ? "Cotización" : "Venta interna")</th><td class="folio">@item.Serie</td><td class="folio">@item.Serie-@item.SiguienteCorrelativo.ToString($"D{item.Digitos}")</td><td>@(item.Activa ? "Activa" : "Inactiva")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdSerieDocumentoInterno">Configurar</a></td></tr> }
    </tbody></table></div>
}
