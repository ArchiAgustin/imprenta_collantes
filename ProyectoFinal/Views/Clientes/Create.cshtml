@model ProyectoFinal.Models.Cliente
@{ Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml"; ViewData["Title"] = "Nuevo cliente"; }
<h1>Nuevo cliente</h1>
<p class="intro">Identifica al cliente con DNI o RUC. Para empresas, registra dirección y ubigeo.</p>
<form asp-action="Create" method="post" class="identity-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_ClienteFormFields" model="Model" />
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cliente</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/identidad-form.js" asp-append-version="true"></script> }
