@model IEnumerable<ProyectoFinal.Models.Cliente>
@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Clientes";
    var canCreate = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Create);
    var canEdit = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Edit);
    var canDelete = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Delete);
}

<div class="page-heading-row"><div><h1>Clientes</h1><p class="intro">Directorio de clientes para cotizaciones y ventas.</p></div>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a> }
</div>
<form asp-action="Index" method="get" class="identity-form search-filters" aria-label="Buscar clientes">
    <div class="identity-form-grid">
        <div class="form-group"><label for="nombre">Nombre</label><input id="nombre" name="nombre" value="@ViewBag.NombreFiltro" class="form-control" /></div>
        <div class="form-group"><label for="documento">Documento</label><input id="documento" name="documento" value="@ViewBag.DocumentoFiltro" class="form-control" /></div>
        <div class="form-group"><label for="correo">Correo</label><input id="correo" name="correo" value="@ViewBag.CorreoFiltro" class="form-control" /></div>
        <div class="form-group"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" value="@ViewBag.TelefonoFiltro" class="form-control" /></div>
    </div>
    <div class="page-actions"><button type="submit" class="btn btn-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<p class="auth-footnote" role="status">@ViewBag.TotalClientes resultado(s)</p>
@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>@(ViewBag.TotalClientes == 0 && (ViewBag.NombreFiltro is not null || ViewBag.DocumentoFiltro is not null || ViewBag.CorreoFiltro is not null || ViewBag.TelefonoFiltro is not null) ? "No hay clientes que coincidan con la búsqueda." : "Aún no hay clientes registrados.")</strong><p>@(ViewBag.TotalClientes == 0 ? "Ajusta los filtros o registra un cliente." : "Empieza creando el primer registro.")</p></div>
}
else
{
<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                Documento
            </th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Correo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @(item.DocumentoIdentidadTipo?.Abreviatura ?? (item.Dni is null ? "Sin documento" : "DNI")) @(item.NumeroDocumento ?? item.Dni)
            </td>
            <td>
                <div class="table-actions">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdCliente">Editar</a> }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdCliente">Ver</a>
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdCliente">Eliminar</a> }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
}
@if ((int)ViewBag.Paginas > 1)
{
    <nav class="page-actions" aria-label="Paginación de clientes">
        <span>Página @ViewBag.Pagina de @ViewBag.Paginas</span>
        @if ((int)ViewBag.Pagina > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-nombre="@ViewBag.NombreFiltro" asp-route-documento="@ViewBag.DocumentoFiltro" asp-route-correo="@ViewBag.CorreoFiltro" asp-route-telefono="@ViewBag.TelefonoFiltro" asp-route-pagina="@((int)ViewBag.Pagina - 1)">Anterior</a> }
        @if ((int)ViewBag.Pagina < (int)ViewBag.Paginas) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-nombre="@ViewBag.NombreFiltro" asp-route-documento="@ViewBag.DocumentoFiltro" asp-route-correo="@ViewBag.CorreoFiltro" asp-route-telefono="@ViewBag.TelefonoFiltro" asp-route-pagina="@((int)ViewBag.Pagina + 1)">Siguiente</a> }
    </nav>
}
