@model IEnumerable<ProyectoFinal.Models.Cliente>
@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Clientes";
    var canCreate = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Create);
    var canEdit = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Edit);
    var canDelete = await MenuAccess.HasPermissionAsync(User, "clientes", ProyectoFinal.Services.MenuPermissionKind.Delete);
}

<h1>Clientes</h1>

<p>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a> }
</p>
@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>Aún no hay clientes registrados.</strong><p>Empieza creando el primer registro.</p></div>
}
else
{
<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                Documento
            </th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Correo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefono)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Direccion)
            </td>
            <td>
                @(item.DocumentoIdentidadTipo?.Abreviatura ?? (item.Dni is null ? "Sin documento" : "DNI")) @(item.NumeroDocumento ?? item.Dni)
            </td>
            <td>
                <div class="table-actions">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdCliente">Editar</a> }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdCliente">Ver</a>
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdCliente">Eliminar</a> }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
}
