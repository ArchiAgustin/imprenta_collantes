@model ProyectoFinal.Models.Cliente
@{ Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml"; ViewData["Title"] = "Editar cliente"; }
<h1>Editar cliente</h1>
<p class="intro">Actualiza el documento y la ubicación. Para RUC, dirección y ubigeo son obligatorios.</p>
<form asp-action="Edit" method="post" class="identity-form">
    <input type="hidden" asp-for="IdCliente" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_ClienteFormFields" model="Model" />
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cambios</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/identidad-form.js" asp-append-version="true"></script> }
