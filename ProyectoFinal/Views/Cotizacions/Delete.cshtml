@model ProyectoFinal.Models.Cotizacion
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = $"Eliminar cotización #{Model.IdCotizacion}";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-PE");
}

<h1>Eliminar cotización #@Model.IdCotizacion</h1>
<p class="intro">Esta acción elimina la cabecera y sus líneas. No se puede deshacer.</p>
<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

<section class="quote-card delete-summary">
    <dl class="quote-audit quote-detail-audit">
        <div><dt>Cliente</dt><dd>@(Model.IdClienteNavigation?.Nombre ?? "Sin cliente")</dd></div>
        <div><dt>Fecha de emisión</dt><dd>@(Model.FechaCreacion?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
        <div><dt>Líneas</dt><dd>@Model.DetalleCotizacions.Count</dd></div>
        <div><dt>Total</dt><dd>@((Model.Total ?? 0).ToString("C2", culture))</dd></div>
    </dl>
    @if (Model.Pedidos.Count > 0)
    {
        <p class="status-note status-error">Esta cotización está vinculada a un pedido y no se puede eliminar.</p>
    }
</section>

<form asp-action="Delete" asp-route-id="@Model.IdCotizacion" method="post" class="page-actions">
    <input type="hidden" name="id" value="@Model.IdCotizacion" />
    @if (Model.Pedidos.Count == 0)
    {
        <button type="submit" class="btn btn-danger">Eliminar cotización</button>
    }
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar y volver</a>
</form>
