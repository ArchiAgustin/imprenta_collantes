@model ProyectoFinal.Models.Cotizacion

@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Eliminar cotización";
}

<h1>Eliminar cotización</h1>

<p class="intro">¿Seguro que deseas eliminar esta cotización? Esta acción no se puede deshacer.</p>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div>
    <h4>Cotizacion</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaCreacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaCreacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaVencimiento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaVencimiento)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DetalleCotizacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DetalleCotizacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Total)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Total)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdClienteNavigation)
        </dt>
        <dd class = "col-sm-10">
            @(Model.IdClienteNavigation?.Nombre ?? "Sin cliente")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdUsuarioNavigation)
        </dt>
        <dd class = "col-sm-10">
            @(Model.IdUsuarioNavigation?.Email ?? "Sin usuario")
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdCotizacion" />
        <input type="submit" value="Eliminar cotización" class="btn btn-danger" /> |
        <a asp-action="Index">Cancelar</a>
    </form>
</div>
