@model ProyectoFinal.Models.Cotizacion
@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = $"Cotización {Model.NumeroInterno}";
    var subtotal = Model.DetalleCotizacions.Sum(linea => decimal.Round((linea.Cantidad ?? 0) * (linea.PrecioUnitario ?? 0), 2, MidpointRounding.AwayFromZero));
    var igv = decimal.Round(subtotal * 0.18m, 2, MidpointRounding.AwayFromZero);
    var culture = System.Globalization.CultureInfo.GetCultureInfo("es-PE");
    var canEdit = await MenuAccess.HasPermissionAsync(User, "cotizaciones", ProyectoFinal.Services.MenuPermissionKind.Edit);
    var canDelete = await MenuAccess.HasPermissionAsync(User, "cotizaciones", ProyectoFinal.Services.MenuPermissionKind.Delete);
    var canSend = await MenuAccess.HasPermissionAsync(User, "cotizaciones", ProyectoFinal.Services.MenuPermissionKind.Create);
    var canConfirmSale = await MenuAccess.HasPermissionAsync(User, "ventas", ProyectoFinal.Services.MenuPermissionKind.Process);
    var warehouses = ViewData["AlmacenesVenta"] as IReadOnlyList<ProyectoFinal.Models.Almacen> ?? Array.Empty<ProyectoFinal.Models.Almacen>();
}

<div class="page-heading-row">
    <div><h1>Cotización @Model.NumeroInterno</h1><p class="intro">Resumen de cabecera y detalle guardados.</p></div>
    @if (canEdit && Model.Estado == "Emitida") { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdCotizacion">Editar cotización</a> }
</div>

<div class="quote-layout quote-readonly-layout">
    <section class="quote-card quote-header-card" aria-labelledby="quote-header-heading">
        <div class="quote-card-heading"><div><h2 id="quote-header-heading">Cabecera</h2><p>Cliente y condiciones</p></div><span class="folio">@Model.NumeroInterno</span></div>
        <dl class="quote-audit quote-detail-audit">
            <div><dt>Cliente</dt><dd>@(Model.ClienteNombreEmision ?? Model.IdClienteNavigation?.Nombre ?? "Sin cliente")</dd></div>
            <div><dt>Fecha de emisión</dt><dd>@(Model.FechaCreacion?.ToString("dd/MM/yyyy") ?? "—")</dd></div>
            <div><dt>Vigencia hasta</dt><dd>@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin vencimiento")</dd></div>
            <div><dt>Responsable</dt><dd>@(Model.IdUsuarioNavigation?.Email ?? "Usuario no disponible")</dd></div>
            <div><dt>Estado</dt><dd>@Model.Estado</dd></div>
            @if (Model.IdCotizacionOrigen is { } origen) { <div><dt>Revalidada desde</dt><dd><a asp-action="Details" asp-route-id="@origen">Cotización #@origen</a></dd></div> }
        </dl>
        <div class="quote-description"><h3>Descripción del trabajo</h3><p>@(string.IsNullOrWhiteSpace(Model.DetalleCotizacion) ? "Sin indicaciones adicionales." : Model.DetalleCotizacion)</p></div>
    </section>

    <section class="quote-card quote-detail-card" aria-labelledby="quote-lines-heading">
        <div class="quote-card-heading"><div><h2 id="quote-lines-heading">Detalle de cotización</h2><p>@Model.DetalleCotizacions.Count línea(s)</p></div></div>
        @if (Model.DetalleCotizacions.Count == 0)
        {
            <div class="empty-state"><p>Esta cotización no contiene líneas de detalle.</p></div>
        }
        else
        {
            <div class="quote-saved-lines">
                @foreach (var line in Model.DetalleCotizacions.OrderBy(line => line.IdDetalleCotizacion))
                {
                    var lineTotal = decimal.Round((line.Cantidad ?? 0) * (line.PrecioUnitario ?? 0), 2, MidpointRounding.AwayFromZero);
                    <article class="quote-saved-line">
                        <div><strong>@(line.IdProductoNavigation is { EsServicio: true } ? "Servicio" : "Artículo") · @(line.ProductoNombreEmision ?? line.IdProductoNavigation?.Nombre ?? "Producto no disponible")</strong><span>@(line.Cantidad ?? 0) × @(line.PresentacionDescripcion ?? "Unidad base") · @((line.PrecioUnitario ?? 0).ToString("C2", culture)) sin IGV</span>@if (line.IdProductoNavigation?.EsServicio != true && line.FactorPresentacion != 1m) { <small>Equivale a @((line.Cantidad ?? 0) * line.FactorPresentacion) @((line.UnidadBaseDescripcion ?? "unidades base"))</small> }</div>
                        <strong>@lineTotal.ToString("C2", culture)</strong>
                    </article>
                }
            </div>
        }
        <div class="quote-totals quote-saved-totals">
            <div><span>Subtotal</span><output>@subtotal.ToString("C2", culture)</output></div>
            <div><span>IGV (18%)</span><output>@igv.ToString("C2", culture)</output></div>
            <div class="quote-grand-total"><strong>Total</strong><output>@((Model.Total ?? subtotal + igv).ToString("C2", culture))</output></div>
        </div>
    </section>
</div>

<div class="page-actions">
    <a class="btn btn-outline-secondary" asp-action="Index">Volver a cotizaciones</a>
    <a class="btn btn-outline-primary" asp-action="Imprimir" asp-route-id="@Model.IdCotizacion" target="_blank" rel="noopener">Imprimir cotización</a>
    <a class="btn btn-outline-primary" asp-action="DescargarPdf" asp-route-id="@Model.IdCotizacion">Descargar PDF</a>
    @if (canSend && Model.Estado == "Emitida")
    {
        if (!string.IsNullOrWhiteSpace(Model.IdClienteNavigation?.Correo))
        {
            <form asp-action="EnviarPorCorreo" method="post" onsubmit="return confirm('¿Enviar esta cotización PDF a @Model.IdClienteNavigation.Correo?');">
                <input type="hidden" name="id" value="@Model.IdCotizacion" />
                <button class="btn btn-primary" type="submit">Enviar al cliente</button>
            </form>
        }
        else { <span class="auth-footnote">Registra un correo en la ficha del cliente para enviar la cotización.</span> }
    }
    @if (await MenuAccess.HasPermissionAsync(User, "cotizaciones", ProyectoFinal.Services.MenuPermissionKind.Create) && Model.Estado == "Vencida")
    { <a class="btn btn-primary" asp-action="Revalidar" asp-route-id="@Model.IdCotizacion">Revisar y emitir nueva</a> }
    @if (canDelete && Model.Estado == "Emitida") { <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.IdCotizacion">Eliminar</a> }
    @if (canConfirmSale && Model.Estado == "Emitida" && warehouses.Count > 0)
    {
        <form asp-controller="Ventas" asp-action="ConfirmarDesdeCotizacion" method="post" onsubmit="return confirm('¿Confirmar esta venta, descontar el stock y crear el trabajo en cola?');">
            <input type="hidden" name="cotizacionId" value="@Model.IdCotizacion" />
            <label for="idAlmacenVenta">Descontar del almacén</label>
            <select id="idAlmacenVenta" name="idAlmacen" class="form-select" required>
                @foreach (var warehouse in warehouses)
                { <option value="@warehouse.IdAlmacen">@warehouse.Nombre@(warehouse.EsPredeterminado ? " · Predeterminado" : "")</option> }
            </select>
            <button class="btn btn-primary" type="submit">Confirmar venta y crear trabajo</button>
        </form>
    }
    else if (canConfirmSale && Model.Estado == "Emitida")
    { <p class="auth-footnote">No hay almacenes activos con corte inicial aplicado; no se puede confirmar la venta.</p> }
</div>
