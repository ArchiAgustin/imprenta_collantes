@using System.Globalization
@model ProyectoFinal.Models.CotizacionFormViewModel
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Nueva cotización";
    var peru = CultureInfo.GetCultureInfo("es-PE");
}

<h1>@(Model.IdCotizacionOrigen is null ? "Nueva cotización" : "Revalidar cotización")</h1>
@if (Model.IdCotizacionOrigen is { } origen)
{
    <p class="status-note">Revisa cliente, cantidades, precios y vigencia de la cotización vencida #@origen. Al guardar se emitirá una nueva cotización; la original no cambiará.</p>
}
<p class="intro">Elige el cliente y arma la cotización con productos del catálogo. Los importes se calculan al guardar. Cuando hay costo conocido, el precio sin IGV debe conservar al menos un 10 % de margen bruto.</p>
<div class="page-actions"><a class="btn btn-outline-primary" asp-controller="PreCotizacion" asp-action="Index">Preparar desde solicitud con IA</a></div>

<form asp-controller="Cotizacions" asp-action="Create" method="post" class="quote-editor" data-quote-editor data-tax-rate="0.18" data-next-index="@Model.Lineas.Count">
    <input type="hidden" asp-for="IdCotizacionOrigen" />
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    @if (Model.ReferenciasPrecio.Count > 0)
    {
        <section class="quote-price-guidance" aria-labelledby="quote-price-guidance-title" data-price-guidance>
            <div class="quote-price-guidance-heading"><div><h2 id="quote-price-guidance-title">Referencia de precio</h2><p>Para el cliente y las cantidades seleccionadas. Calculada en el servidor, sin enviar costos ni historial a Groq.</p></div><span class="role-badge">Margen mínimo 10 %</span></div>
            <ul class="quote-price-guidance-list">
            @foreach (var reference in Model.ReferenciasPrecio)
            {
                <li><strong>@reference.NombreProducto</strong><span>@reference.CantidadSolicitada × @reference.Presentacion</span>
                    @if (reference.PrecioRecomendadoSinIgv is { } recomendado)
                    {
                        <p>Precio recomendado por presentación sin IGV: <strong>@recomendado.ToString("C2", peru)</strong>. @reference.MotivoRecomendacion El vendedor decide el precio final.</p>
                    }
                    else { <p>No hay recomendación de precio para este producto y cantidad; revisa las referencias disponibles.</p> }
                    @if (reference.PrecioMinimoSinIgv is { } minimo)
                    {
                        <p>Mínimo por presentación sin IGV: <strong>@minimo.ToString("C2", peru)</strong>@(reference.CostoEstimado ? " · basado en costo estimado de servicio" : "").</p>
                        @if (reference.DescuentoMaximoPorcentaje is { } descuento)
                        {
                            <p>Desde el precio actual de catálogo (@reference.PrecioCatalogoSinIgv!.Value.ToString("C2", peru)), el descuento máximo compatible es <strong>@descuento.ToString("N2", peru) %</strong>. Es un límite, no una oferta recomendada.</p>
                        }
                        else { <p class="text-danger">El catálogo no tiene precio válido sobre este mínimo. Revisa el precio antes de guardar.</p> }
                    }
                    else { <p>No se calcula descuento: falta un costo unitario mayor que cero. No se asume costo cero.</p> }
                    @if (reference.UltimoPrecioClienteSinIgv is { } anterior)
                    {
                        <p>Última venta confirmada a este cliente con factor comparable: @anterior.ToString("C2", peru) sin IGV por presentación (@reference.UltimaCantidadCliente unidades).
                        @if (reference.PrecioHistoricoAplicableSinIgv is { } historico)
                        { <span>Referencia para evaluar: <strong>@historico.ToString("C2", peru)</strong> sin IGV; no se aplicó automáticamente.</span> }
                        else { <span>No se propone repetirla: puede quedar bajo el mínimo, superar el catálogo o corresponder a mayor tiraje.</span> }
                        </p>
                    }
                </li>
            }
            </ul>
            <p class="quote-price-guidance-note">Si cambias cliente, producto, cantidad o precio, estas referencias dejan de corresponder. El servidor vuelve a validar el margen al guardar y antes de confirmar la venta.</p>
            <p class="quote-price-guidance-note" data-price-guidance-stale hidden role="status">Editaste la cotización: las referencias anteriores ya no corresponden a estos datos.</p>
        </section>
    }
    <div class="quote-layout">
        <section class="quote-card quote-header-card" aria-labelledby="quote-header-heading">
            <div class="quote-card-heading">
                <div>
                    <h2 id="quote-header-heading">Cabecera</h2>
                    <p>Cliente y condiciones</p>
                </div>
                <span class="folio">NUEVA</span>
            </div>

            <div class="form-group">
                <label asp-for="ClienteId" class="control-label">Cliente</label>
                <select asp-for="ClienteId" class="form-select">
                    <option value="">Selecciona un cliente</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.IdCliente">@cliente.Nombre</option>
                    }
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FechaVencimiento" class="control-label">Vigencia hasta (7 días de forma predeterminada)</label>
                <input asp-for="FechaVencimiento" type="date" class="form-control" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="control-label">Descripción del trabajo <span class="field-optional">(opcional)</span></label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Medidas, acabados u otras indicaciones" maxlength="4000"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <dl class="quote-audit">
                <div><dt>Fecha de emisión</dt><dd>@Model.FechaEmision.ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Responsable</dt><dd>@Model.Usuario</dd></div>
            </dl>
            <p class="auth-footnote">La fecha y el responsable se registran automáticamente.</p>
        </section>

        <section class="quote-card quote-detail-card" aria-labelledby="quote-lines-heading">
            <div class="quote-card-heading quote-detail-heading">
                <div>
                    <h2 id="quote-lines-heading">Detalle de cotización</h2>
                    <p>Productos, cantidades y precios pactados</p>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" data-add-line @(Model.Productos.Count == 0 ? "disabled" : null)>Agregar producto</button>
            </div>

            @if (Model.Productos.Count == 0)
            {
                <div class="empty-state" role="status"><strong>El catálogo está vacío.</strong><p>Registra un producto antes de preparar una cotización.</p></div>
                <div class="page-actions"><a class="btn btn-outline-secondary" asp-action="Index">Volver a cotizaciones</a></div>
            }
            else
            {
                <div asp-validation-for="Lineas" class="text-danger quote-lines-error"></div>
                <div id="quote-lines" class="quote-lines">
                    @for (var index = 0; index < Model.Lineas.Count; index++)
                    {
                        <div class="quote-line" data-quote-line>
                            <div class="quote-line-heading"><strong data-line-label>Producto @(index + 1)</strong><button type="button" class="btn btn-sm btn-outline-danger quote-remove-line" data-remove-line aria-label="Quitar producto @(index + 1)">Quitar</button></div>
                            <div class="form-group quote-product-field">
                                <label asp-for="Lineas[index].ProductoId" class="control-label">Producto</label>
                                <select asp-for="Lineas[index].ProductoId" class="form-select quote-product-select">
                                    <option value="">Selecciona del catálogo</option>
                                    @foreach (var producto in Model.Productos)
                                    {
                                    <option value="@producto.IdProducto" data-unit-price="@(producto.Precio?.ToString(CultureInfo.InvariantCulture) ?? "0")" data-es-servicio="@producto.EsServicio.ToString().ToLowerInvariant()" data-base-unit="@(producto.UnidadMedidaBase?.DescripcionCorta ?? producto.UnidadMedidaBase?.Descripcion ?? "Unidad base")" selected="@(Model.Lineas[index].ProductoId == producto.IdProducto ? "selected" : null)">@(producto.EsServicio ? "Servicio" : "Artículo") · @producto.Nombre</option>
                                    }
                                </select>
                                <span asp-validation-for="Lineas[index].ProductoId" class="text-danger"></span>
                            </div>
                            <div class="form-group quote-presentation-field">
                                <label asp-for="Lineas[index].IdPresentacionProducto">Presentación</label>
                                <select asp-for="Lineas[index].IdPresentacionProducto" class="form-select quote-presentation-select">
                                    <option value="" data-product-id="" data-factor="1" data-label="Unidad base">Unidad base</option>
                                    @foreach (var product in Model.Productos)
                                    {
                                        @foreach (var presentation in product.Presentaciones)
                                        {
                                            <option value="@presentation.IdPresentacionProducto" data-product-id="@product.IdProducto" data-is-base="@(presentation.IdUnidadMedida == product.IdUnidadMedidaBase && presentation.Factor == 1m ? "true" : "false")" data-factor="@presentation.Factor.ToString(CultureInfo.InvariantCulture)" data-label="@presentation.Descripcion" data-unit-base="@(product.UnidadMedidaBase?.DescripcionCorta ?? product.UnidadMedidaBase?.Descripcion ?? "Unidad base")" selected="@(Model.Lineas[index].IdPresentacionProducto == presentation.IdPresentacionProducto ? "selected" : null)">@product.Nombre · @presentation.Descripcion (@presentation.Factor.ToString("0.###") @presentation.UnidadMedida.Descripcion)</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Lineas[index].IdPresentacionProducto" class="text-danger"></span>
                            </div>
                            <div class="quote-line-fields">
                                <div class="form-group">
                                    <label asp-for="Lineas[index].Cantidad" class="control-label" data-quantity-label>Cantidad</label>
                                    <input asp-for="Lineas[index].Cantidad" class="form-control quote-quantity" type="number" min="1" max="1000000" step="1" />
                                    <span asp-validation-for="Lineas[index].Cantidad" class="text-danger"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Lineas[index].PrecioUnitario" class="control-label" data-price-label>Precio por presentación sin IGV</label>
                                    <div class="input-with-prefix"><span>S/</span><input asp-for="Lineas[index].PrecioUnitario" class="form-control quote-price" type="number" min="0" max="99999999.99" step="0.01" /></div>
                                    <span asp-validation-for="Lineas[index].PrecioUnitario" class="text-danger"></span>
                                </div>
                                <div class="quote-line-amount"><span>Importe</span><output data-line-total>S/ 0,00</output></div>
                            </div>
                        </div>
                    }
                </div>

                <template id="quote-line-template">
                    <div class="quote-line" data-quote-line>
                        <div class="quote-line-heading"><strong data-line-label>Producto</strong><button type="button" class="btn btn-sm btn-outline-danger quote-remove-line" data-remove-line aria-label="Quitar producto">Quitar</button></div>
                        <div class="form-group quote-product-field">
                            <label class="control-label" for="Lineas___index___ProductoId">Producto</label>
                            <select id="Lineas___index___ProductoId" name="Lineas[__index__].ProductoId" class="form-select quote-product-select" data-val="true" data-val-required="Selecciona un producto.">
                                <option value="">Selecciona del catálogo</option>
                                @foreach (var producto in Model.Productos)
                                {
                                    <option value="@producto.IdProducto" data-unit-price="@(producto.Precio?.ToString(CultureInfo.InvariantCulture) ?? "0")" data-es-servicio="@producto.EsServicio.ToString().ToLowerInvariant()" data-base-unit="@(producto.UnidadMedidaBase?.DescripcionCorta ?? producto.UnidadMedidaBase?.Descripcion ?? "Unidad base")">@(producto.EsServicio ? "Servicio" : "Artículo") · @producto.Nombre</option>
                                }
                            </select>
                            <span class="text-danger" data-valmsg-for="Lineas[__index__].ProductoId" data-valmsg-replace="true"></span>
                        </div>
                        <div class="form-group quote-presentation-field">
                            <label class="control-label" for="Lineas___index___IdPresentacionProducto">Presentación</label>
                            <select id="Lineas___index___IdPresentacionProducto" name="Lineas[__index__].IdPresentacionProducto" class="form-select quote-presentation-select">
                                <option value="" data-product-id="" data-factor="1" data-label="Unidad base">Unidad base</option>
                                @foreach (var product in Model.Productos)
                                {
                                    @foreach (var presentation in product.Presentaciones)
                                    {
                                        <option value="@presentation.IdPresentacionProducto" data-product-id="@product.IdProducto" data-is-base="@(presentation.IdUnidadMedida == product.IdUnidadMedidaBase && presentation.Factor == 1m ? "true" : "false")" data-factor="@presentation.Factor.ToString(CultureInfo.InvariantCulture)" data-label="@presentation.Descripcion" data-unit-base="@(product.UnidadMedidaBase?.DescripcionCorta ?? product.UnidadMedidaBase?.Descripcion ?? "Unidad base")">@product.Nombre · @presentation.Descripcion (@presentation.Factor.ToString("0.###") @presentation.UnidadMedida.Descripcion)</option>
                                    }
                                }
                            </select>
                            <span class="text-danger" data-valmsg-for="Lineas[__index__].IdPresentacionProducto" data-valmsg-replace="true"></span>
                        </div>
                        <div class="quote-line-fields">
                            <div class="form-group">
                                <label class="control-label" for="Lineas___index___Cantidad" data-quantity-label>Cantidad</label>
                                <input id="Lineas___index___Cantidad" name="Lineas[__index__].Cantidad" class="form-control quote-quantity" type="number" min="1" max="1000000" step="1" value="1" data-val="true" data-val-range="La cantidad debe estar entre 1 y 1 000 000." data-val-range-min="1" data-val-range-max="1000000" />
                                <span class="text-danger" data-valmsg-for="Lineas[__index__].Cantidad" data-valmsg-replace="true"></span>
                            </div>
                            <div class="form-group">
                                <label class="control-label" for="Lineas___index___PrecioUnitario" data-price-label>Precio por presentación sin IGV</label>
                                <div class="input-with-prefix"><span>S/</span><input id="Lineas___index___PrecioUnitario" name="Lineas[__index__].PrecioUnitario" class="form-control quote-price" type="number" min="0" max="99999999.99" step="0.01" value="0.00" data-val="true" data-val-range="Ingresa un precio válido." data-val-range-min="0" data-val-range-max="99999999.99" /></div>
                                <span class="text-danger" data-valmsg-for="Lineas[__index__].PrecioUnitario" data-valmsg-replace="true"></span>
                            </div>
                            <div class="quote-line-amount"><span>Importe</span><output data-line-total>S/ 0,00</output></div>
                        </div>
                    </div>
                </template>

                <div class="quote-totals" aria-live="polite" aria-atomic="true">
                    <div><span>Subtotal</span><output data-subtotal>@Model.Totales.SubtotalMoneda</output></div>
                    <div><span>IGV (18%)</span><output data-igv>@Model.Totales.IgvMoneda</output></div>
                    <div class="quote-grand-total"><strong>Total</strong><output data-total>@Model.Totales.TotalMoneda</output></div>
                </div>
                <p class="quote-calculation-note">El importe mostrado es una estimación de la página; el servidor valida y calcula los valores al guardar.</p>

                <div class="page-actions quote-form-actions">
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                    <button type="submit" class="btn btn-outline-primary" formaction="@Url.Action("RevisarPrecio", "Cotizacions")" formnovalidate>Revisar precio recomendado</button>
                    <button type="submit" class="btn btn-primary">Guardar cotización</button>
                </div>
            }
        </section>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cotizacion-editor.js" asp-append-version="true"></script>
}
