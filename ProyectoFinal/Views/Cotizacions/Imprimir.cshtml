@using System.Globalization
@model ProyectoFinal.Models.Cotizacion
@{
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    ViewData["Title"] = $"Cotización {Model.NumeroInterno}";
    var peru = CultureInfo.GetCultureInfo("es-PE");
    var subtotal = Model.DetalleCotizacions.Sum(item => decimal.Round((item.Cantidad ?? 0) * (item.PrecioUnitario ?? 0), 2, MidpointRounding.AwayFromZero));
    var igv = decimal.Round(subtotal * .18m, 2, MidpointRounding.AwayFromZero);
}
<header class="print-header"><div><img src="~/img/marca-collantes.svg" width="52" height="52" alt="" /><strong>IMPRENTA COLLANTES</strong><small>Propuesta comercial</small></div><div class="print-number"><span>COTIZACIÓN</span><strong>@Model.NumeroInterno</strong></div></header>
<div class="print-status"><span>Estado: @Model.Estado</span>@if (Model.IdCotizacionOrigen is { } origen) { <span>Revisión de cotización #@origen</span> }</div>
<dl class="print-facts"><div><dt>Cliente al emitir</dt><dd>@(Model.ClienteNombreEmision ?? "No registrado en cotización histórica")</dd></div><div><dt>Emisión</dt><dd>@(Model.FechaCreacion?.ToString("dd/MM/yyyy") ?? "No registrada")</dd></div><div><dt>Vigencia hasta</dt><dd>@(Model.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</dd></div><div><dt>Documento del cliente</dt><dd>@(Model.ClienteDocumentoEmision ?? "No registrado")</dd></div><div><dt>Dirección</dt><dd>@(Model.ClienteDireccionEmision ?? "No registrada")</dd></div></dl>
@if (!string.IsNullOrWhiteSpace(Model.DetalleCotizacion)) { <section class="print-description"><h2>Descripción del trabajo</h2><p>@Model.DetalleCotizacion</p></section> }
<table class="print-lines"><thead><tr><th scope="col">Descripción</th><th scope="col" class="numeric">Cant. / presentación</th><th scope="col" class="numeric">P. presentación sin IGV</th><th scope="col" class="numeric">Importe</th></tr></thead><tbody>
@foreach (var item in Model.DetalleCotizacions.OrderBy(item => item.IdDetalleCotizacion))
{ <tr><th scope="row">@(item.ProductoNombreEmision ?? $"Producto histórico #{item.IdProducto}")</th><td class="numeric">@item.Cantidad × @(item.PresentacionDescripcion ?? "Unidad base")@if (item.FactorPresentacion != 1m && !string.IsNullOrWhiteSpace(item.UnidadBaseDescripcion)) { <small class="d-block">= @((item.Cantidad ?? 0) * item.FactorPresentacion) @item.UnidadBaseDescripcion</small> }</td><td class="numeric">@item.PrecioUnitario?.ToString("C2", peru)</td><td class="numeric">@(((item.Cantidad ?? 0) * (item.PrecioUnitario ?? 0)).ToString("C2", peru))</td></tr> }
</tbody></table>
<dl class="print-totals"><div><dt>Subtotal sin IGV</dt><dd>@subtotal.ToString("C2", peru)</dd></div><div><dt>IGV (18 %)</dt><dd>@igv.ToString("C2", peru)</dd></div><div class="print-total"><dt>Total</dt><dd>@(Model.Total?.ToString("C2", peru) ?? "No registrado")</dd></div></dl>
<footer class="print-foot">Cotización comercial · los importes impresos corresponden a las condiciones guardadas actualmente.</footer>
