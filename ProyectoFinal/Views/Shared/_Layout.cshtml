@using Microsoft.AspNetCore.Identity
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Imprenta Collantes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <div class="container-xl header-inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Imprenta Collantes, inicio">
                <img src="~/img/marca-collantes.svg" alt="" width="42" height="42" />
                <span><strong>Collantes</strong><small>GESTIÓN DE IMPRENTA</small></span>
            </a>
            <nav aria-label="Cuenta" class="header-account"><partial name="_LoginPartial" /></nav>
        </div>
    </header>
    <main id="contenido" class="container-xl public-content">@RenderBody()</main>
    <footer class="site-footer"><div class="container-xl">Imprenta Collantes <span aria-hidden="true">·</span> Gestión comercial</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
