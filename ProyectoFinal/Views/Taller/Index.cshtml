@model IReadOnlyList<ProyectoFinal.Models.Pedido>
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Cola de taller";
}

<h1>Cola de taller</h1>
<p class="intro">Trabajos generados desde ventas confirmadas. El operador los avanza en secuencia.</p>

@if (Model.Count == 0)
{
    <div class="empty-state" role="status"><strong>La cola está vacía.</strong><p>Las ventas confirmadas aparecerán aquí como nuevos trabajos.</p></div>
}
else
{
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Trabajo</th><th>Venta</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Detalle</th><th></th></tr></thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <th scope="row">#@order.IdPedido</th>
                <td>@(order.IdVenta is null ? "—" : $"#{order.IdVenta}")</td>
                <td>@(order.IdVentaNavigation?.Cliente?.Nombre ?? "Cliente no disponible")</td>
                <td>@(order.FechaPedido?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>@order.EstadoPedido</td>
                <td>@string.Join(", ", order.DetallePedidos.Select(line => $"{line.Cantidad} × {line.ProductoNombre ?? line.IdProductoNavigation?.Nombre ?? "Producto"}"))</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.IdPedido">Ver trabajo</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
