@model IEnumerable<ProyectoFinal.Models.Producto>
@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Productos";
    var canCreate = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Create);
    var canEdit = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Edit);
    var canDelete = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Delete);
    var inventoryActive = (bool?)ViewData["InventarioActivo"] == true;
    var balances = (Dictionary<int, decimal>?)ViewData["SaldosInventario"] ?? new();
}

<h1>Productos</h1>

<p>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">Nuevo producto</a> }
</p>
@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>Aún no hay productos registrados.</strong><p>Empieza creando el primer registro.</p></div>
}
else
{
<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Precio)
            </th>
            @if (User.IsInRole("Admin")) { <th scope="col">Costo unitario sin IGV</th> }
            <th>
                Tipo
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdProveedorNavigation)
            </th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Precio)
            </td>
            @if (User.IsInRole("Admin"))
            {
                <td>@(item.CostoUnitarioSinIgv is { } costo ? costo.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-PE")) : "Sin registrar")</td>
            }
            <td>
                @(item.EsServicio ? "Servicio" : "Artículo")
            </td>
            <td>
                @(item.EsServicio ? "No aplica" : inventoryActive ? balances.TryGetValue(item.IdProducto, out var balance) ? balance.ToString("0.###") : "Sin saldo" : (item.Stock ?? 0).ToString())
            </td>
            <td>
                @(item.IdProveedorNavigation?.Nombre ?? "Sin proveedor")
            </td>
            <td>
                <div class="table-actions">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdProducto">Editar</a> }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdProducto">Ver</a>
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdProducto">Eliminar</a> }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
}
