@model IEnumerable<ProyectoFinal.Models.Producto>
@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = "~/Areas/Identity/Pages/Shared/_PanelLayout.cshtml";
    ViewData["Title"] = "Productos";
    var canCreate = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Create);
    var canEdit = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Edit);
    var canDelete = await MenuAccess.HasPermissionAsync(User, "productos", ProyectoFinal.Services.MenuPermissionKind.Delete);
    var balances = (Dictionary<int, decimal>?)ViewData["SaldosInventario"] ?? new();
    var inventoryMode = ViewData["ModoInventario"] as string ?? "Legado";
    var warehouseName = ViewData["AlmacenSeleccionadoNombre"] as string;
    var warehouses = ViewData["Almacenes"] as IReadOnlyList<ProyectoFinal.Models.Almacen> ?? Array.Empty<ProyectoFinal.Models.Almacen>();
    var selectedWarehouseId = ViewData["AlmacenSeleccionadoId"] as int?;
}

<div class="page-heading-row"><div><h1>Productos</h1><p class="intro">Productos y servicios registrados, con stock por almacén.</p></div>
    @if (canCreate) { <a class="btn btn-primary" asp-action="Create">Nuevo producto</a> }
</div>

@if (warehouses.Count > 1)
{
    <form asp-action="Index" method="get" class="product-warehouse-filter">
        <label for="productWarehouse">Existencias en</label>
        <select id="productWarehouse" name="almacenId" class="form-select">
            @foreach (var warehouse in warehouses)
            { <option value="@warehouse.IdAlmacen" selected="@(warehouse.IdAlmacen == selectedWarehouseId ? "selected" : null)">@warehouse.Nombre@(warehouse.FechaActivacionUtc is null ? " · Corte inicial pendiente" : "")</option> }
        </select>
        <button class="btn btn-outline-primary" type="submit">Ver saldos</button>
    </form>
}

@if (!Model.Any())
{
    <div class="empty-state" role="status"><strong>Aún no hay productos registrados.</strong><p>Empieza creando el primer registro.</p></div>
}
else
{
<div class="table-responsive">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                Precio por unidad base
            </th>
            @if (User.IsInRole("Admin")) { <th scope="col">Costo unitario sin IGV</th> }
            <th>
                Tipo
            </th>
            <th>Unidad base</th>
            <th>
                @(warehouseName is null ? "Stock" : $"Stock · {warehouseName}")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdProveedorNavigation)
            </th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Precio)
            </td>
            @if (User.IsInRole("Admin"))
            {
                <td>@(item.CostoUnitarioSinIgv is { } costo ? costo.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-PE")) : "Sin registrar")</td>
            }
            <td>
                @(item.EsServicio ? "Servicio" : "Artículo")
            </td>
            <td>@(item.EsServicio ? "—" : item.UnidadMedidaBase?.Descripcion ?? "Sin configurar")</td>
            <td>
                @(item.EsServicio ? "No aplica" : inventoryMode == "Activo" ? balances.TryGetValue(item.IdProducto, out var balance) ? balance.ToString("0.###") : "Sin saldo" : inventoryMode == "CortePendiente" ? "Corte inicial pendiente" : (item.Stock ?? 0).ToString())
            </td>
            <td>
                @(item.IdProveedorNavigation?.Nombre ?? "Sin proveedor")
            </td>
            <td>
                <div class="table-actions">
                    @if (canEdit) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.IdProducto">Editar</a> }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.IdProducto" asp-route-almacenId="@selectedWarehouseId">Ver</a>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#stockPorAlmacenModal" data-stock-url="@Url.Action("StockPorAlmacen", "Productoes", new { id = item.IdProducto })">Stock por almacén</button>
                    @if (canDelete) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.IdProducto">Eliminar</a> }
                </div>
            </td>
        </tr>
}

    </tbody>
</table>
</div>
}

<div class="modal fade" id="stockPorAlmacenModal" tabindex="-1" aria-labelledby="stockPorAlmacenTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="stockPorAlmacenTitulo">Stock por almacén</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
        <div class="modal-body" id="stockPorAlmacenContenido" aria-live="polite"><p>Cargando existencias…</p></div>
    </div></div>
</div>

@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById("stockPorAlmacenModal");
            const body = document.getElementById("stockPorAlmacenContenido");
            if (!modal || !body) return;
            modal.addEventListener("show.bs.modal", async event => {
                const trigger = event.relatedTarget;
                const url = trigger?.getAttribute("data-stock-url");
                body.innerHTML = "<p>Cargando existencias…</p>";
                if (!url) { body.textContent = "No se pudo cargar la información de stock."; return; }
                try {
                    const response = await fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } });
                    if (!response.ok) throw new Error("No se pudieron cargar las existencias.");
                    body.innerHTML = await response.text();
                } catch {
                    body.textContent = "No se pudieron cargar las existencias. Cierra la ventana e inténtalo nuevamente.";
                }
            });
        })();
    </script>
}
