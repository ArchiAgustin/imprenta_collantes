@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<h1>No pudimos completar la solicitud</h1>
<p>Ocurrió un problema inesperado. Vuelve a intentarlo; si continúa, comunícate con el administrador.</p>
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}
