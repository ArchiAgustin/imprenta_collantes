@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de recuperación";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Este inicio de sesión no quedará recordado hasta que uses tu aplicación autenticadora
    o desactives la verificación en dos pasos y vuelvas a ingresar.
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Código de recuperación" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Ingresar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
