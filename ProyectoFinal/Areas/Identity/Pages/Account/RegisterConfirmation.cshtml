@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    Confirma tu cuenta desde el <a id="confirm-link" href="@Model.EmailConfirmationUrl">enlace de confirmación</a>.
</p>
    }
    else
    {
<p>
        Revisa tu correo electrónico para confirmar la cuenta.
</p>
    }
}

