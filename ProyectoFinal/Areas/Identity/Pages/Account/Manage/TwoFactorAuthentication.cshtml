@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Verificación en dos pasos";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>No quedan códigos de recuperación.</strong>
                    <p>Debes <a asp-page="./GenerateRecoveryCodes">generar códigos nuevos</a> para volver a ingresar con un código de recuperación.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Queda 1 código de recuperación.</strong>
                    <p>Puedes <a asp-page="./GenerateRecoveryCodes">generar códigos nuevos</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Quedan @Model.RecoveryCodesLeft códigos de recuperación.</strong>
                    <p>Conviene <a asp-page="./GenerateRecoveryCodes">generar códigos nuevos</a>.</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-primary">Dejar de recordar este navegador</button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-primary">Desactivar verificación en dos pasos</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-primary">Generar códigos nuevos</a>
        }

        <h4>Aplicación autenticadora</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Agregar aplicación autenticadora</a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Configurar aplicación autenticadora</a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-primary">Restablecer aplicación autenticadora</a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>No se aceptó la política de privacidad y cookies.</strong>
            <p>Debes aceptarla antes de activar la verificación en dos pasos.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
