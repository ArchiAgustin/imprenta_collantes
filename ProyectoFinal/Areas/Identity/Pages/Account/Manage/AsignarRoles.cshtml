                           @page
@model ProyectoFinal.Areas.Identity.Pages.Account.Manage.AsignarRolesModel
@{
    ViewData["Title"] = "Asignar Roles";
}

<h2>Asignar un único rol por usuario</h2>

@foreach (var user in Model.Users)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5>@user.UserName (@user.Email)</h5>

            <form method="post">
                <input type="hidden" name="userId" value="@user.Id" />
                <div class="form-group">
                    <label for="roleSelect_@user.Id">Rol asignado:</label>
                    <select class="form-control" id="roleSelect_@user.Id" name="selectedRole">
                        <option value="">-- Ninguno --</option>
                        @foreach (var role in Model.AllRoles)
                        {
                            var isSelected = Model.UserRoles[user.Id].Contains(role);
                            <option value="@role" selected="@(isSelected ? "selected" : null)">@role</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary mt-2">Asignar Rol</button>
            </form>
        </div>
    </div>
}
