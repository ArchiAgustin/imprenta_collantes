@page
@model ProyectoFinal.Areas.Identity.Pages.Account.Manage.IndexModelRole

@{
    ViewData["Title"] = "Administrar roles";
}

<h2>Administrar roles</h2>

<a class="btn btn-primary" asp-page="./CreateRole">Nuevo Rol</a>

<h3>Roles existentes</h3>
<table class="table">
    <thead>
        <tr>
            <th>Nombre del rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model.Roles)
        {
            <tr>
                <td>@role.Name</td>
                <td>
                    <a href="@Url.Page("./EditRole", new { id = role.Id })" class="btn btn-warning btn-sm">Editar</a>
                    <form method="post" asp-page="./IndexRole" asp-page-handler="Delete" asp-route-id="@role.Id" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Eliminar este rol? Esta acción no se puede deshacer.');">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
