@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desactivar verificación en dos pasos";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta acción solo desactiva la verificación en dos pasos.</strong>
    </p>
    <p>
        La clave de la aplicación autenticadora no cambiará. Si quieres cambiarla,
        <a asp-page="./ResetAuthenticator">restablece la clave de autenticación</a>.
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Desactivar verificación en dos pasos</button>
    </form>
</div>
