@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generar códigos de recuperación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Guarda los códigos en un lugar seguro.</strong>
    </p>
    <p>
        Si pierdes tu dispositivo y no tienes los códigos, perderás el acceso a tu cuenta.
    </p>
    <p>
        Generar códigos nuevos no cambia la clave de tu aplicación autenticadora. Para cambiarla,
        <a asp-page="./ResetAuthenticator">restablece la clave de autenticación</a>.
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Generar códigos nuevos</button>
    </form>
</div>
