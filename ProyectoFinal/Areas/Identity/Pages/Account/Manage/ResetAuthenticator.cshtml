@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Restablecer clave de autenticación";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Si restableces la clave, la aplicación autenticadora no funcionará hasta que la configures de nuevo.</strong>
    </p>
    <p>
        La verificación en dos pasos se desactivará hasta que confirmes la aplicación autenticadora.
        Si no completas la configuración, podrías perder el acceso a la cuenta.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Restablecer clave de autenticación</button>
    </form>
</div>
