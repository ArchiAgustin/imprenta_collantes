@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = null;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isPanel = ViewContext.RouteData.Values["page"]?.ToString() == "/Usuario/Panel";
    var isAdmin = User.IsInRole("Admin");
    var menus = User.Identity?.IsAuthenticated == true
        ? await MenuAccess.GetNavigationMenusAsync(User)
        : Array.Empty<ProyectoFinal.Services.MenuNavigationItem>();
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Imprenta Collantes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="panel-body">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <div class="container-fluid header-inner">
            <a class="brand" asp-area="Identity" asp-page="/Usuario/Panel" aria-label="Imprenta Collantes, panel">
                <img src="~/img/marca-collantes.svg" alt="" width="42" height="42" />
                <span><strong>Collantes</strong><small>GESTIÓN DE IMPRENTA</small></span>
            </a>
            <div class="header-actions">
                <button class="btn nav-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#panelNav" aria-controls="panelNav" aria-expanded="false">Menú</button>
                <nav aria-label="Cuenta" class="header-account"><partial name="_LoginPartial" /></nav>
            </div>
        </div>
    </header>
    <div class="panel-shell">
        <nav id="panelNav" class="panel-nav collapse d-lg-block" aria-label="Módulos">
            <div class="nav-heading">ÁREA DE TRABAJO</div>
            <a class="panel-link @(isPanel ? "is-current" : "")" asp-area="Identity" asp-page="/Usuario/Panel" aria-current="@(isPanel ? "page" : null)">Inicio</a>
            @foreach (var menu in menus)
            {
                <a class="panel-link @(controller == menu.ControllerNombre ? "is-current" : "")" asp-area="" asp-controller="@menu.ControllerNombre" asp-action="Index" aria-current="@(controller == menu.ControllerNombre ? "page" : null)">@menu.Nombre</a>
            }
            @if (isAdmin)
            {
                <div class="nav-heading nav-heading-spaced">ADMINISTRACIÓN</div>
                <a class="panel-link @(controller == "SeriesInternas" ? "is-current" : "")" asp-area="" asp-controller="SeriesInternas" asp-action="Index" aria-current="@(controller == "SeriesInternas" ? "page" : null)">Series internas</a>
                <a class="panel-link @(controller == "Inventario" ? "is-current" : "")" asp-area="" asp-controller="Inventario" asp-action="Index" aria-current="@(controller == "Inventario" ? "page" : null)">Inventario · Almacén principal</a>
                <a class="panel-link @(controller == "Admin" ? "is-current" : "")" asp-area="" asp-controller="Admin" asp-action="Index" aria-current="@(controller == "Admin" ? "page" : null)">Usuarios</a>
                <a class="panel-link @(controller == "Roles" ? "is-current" : "")" asp-area="" asp-controller="Roles" asp-action="Index" aria-current="@(controller == "Roles" ? "page" : null)">Roles</a>
                <a class="panel-link @(controller == "Permisos" ? "is-current" : "")" asp-area="" asp-controller="Permisos" asp-action="Index" aria-current="@(controller == "Permisos" ? "page" : null)">Permisos de menú</a>
                <a class="panel-link @(controller == "Auditoria" ? "is-current" : "")" asp-area="" asp-controller="Auditoria" asp-action="Index" aria-current="@(controller == "Auditoria" ? "page" : null)">Auditoría</a>
                <a class="panel-link @(controller == "Analytics" ? "is-current" : "")" asp-area="" asp-controller="Analytics" asp-action="Index" aria-current="@(controller == "Analytics" ? "page" : null)">Analítica</a>
            }
            <div class="nav-footer">Un espacio para cada trabajo.</div>
        </nav>
        <main id="contenido" class="panel-main" role="main">
            <div class="work-sheet">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="status-note status-success" role="status">@successMessage</div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="status-note status-error" role="alert">@errorMessage</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
