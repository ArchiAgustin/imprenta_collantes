@inject ProyectoFinal.Services.IMenuAccessService MenuAccess
@{
    Layout = null;
    var isPanel = ViewContext.RouteData.Values["page"]?.ToString() == "/Usuario/Panel";
    var menus = User.Identity?.IsAuthenticated == true
        ? await MenuAccess.GetNavigationMenusAsync(User)
        : Array.Empty<ProyectoFinal.Services.MenuNavigationItem>();
    var roleIds = User.FindAll(ProyectoFinal.Services.ActiveRoleMiddleware.AvailableRoleIdClaim).Select(claim => claim.Value).ToList();
    var roleNames = User.FindAll(ProyectoFinal.Services.ActiveRoleMiddleware.AvailableRoleNameClaim).Select(claim => claim.Value).ToList();
    var activeRoleId = User.FindFirst(ProyectoFinal.Services.ActiveRoleMiddleware.ActiveRoleIdClaim)?.Value;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Imprenta Collantes</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="panel-body">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <div class="container-fluid header-inner">
            <a class="brand" asp-area="Identity" asp-page="/Usuario/Panel" aria-label="Imprenta Collantes, panel">
                <img src="~/img/marca-collantes.svg" alt="" width="42" height="42" />
                <span><strong>Collantes</strong><small>GESTIÓN DE IMPRENTA</small></span>
            </a>
            @if (roleIds.Count > 1)
            {
                <form class="active-role-form" asp-area="" asp-controller="RoleSelection" asp-action="Cambiar" method="post" aria-label="Cambiar rol activo">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <label for="activeRoleId">Rol activo</label>
                    <select id="activeRoleId" name="roleId" aria-label="Rol que se usará para esta sesión">
                        @for (var roleIndex = 0; roleIndex < roleIds.Count; roleIndex++)
                        {
                            <option value="@roleIds[roleIndex]" selected="@(roleIds[roleIndex] == activeRoleId ? "selected" : null)">@roleNames.ElementAtOrDefault(roleIndex)</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Cambiar</button>
                </form>
            }
            <div class="header-actions">
                <button class="btn nav-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#panelNav" aria-controls="panelNav" aria-expanded="false">Menú</button>
                <nav aria-label="Cuenta" class="header-account"><partial name="_LoginPartial" /></nav>
            </div>
        </div>
    </header>
    <div class="panel-shell">
        <nav id="panelNav" class="panel-nav collapse d-lg-block" aria-label="Módulos">
            <div class="nav-heading">ÁREA DE TRABAJO</div>
            <a class="panel-link @(isPanel ? "is-current" : "")" asp-area="Identity" asp-page="/Usuario/Panel" aria-current="@(isPanel ? "page" : null)">Inicio</a>
            <partial name="~/Views/Shared/_MenuTree.cshtml" model="menus" />
            <div class="nav-footer">Un espacio para cada trabajo.</div>
        </nav>
        <main id="contenido" class="panel-main" role="main">
            <div class="work-sheet">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="status-note status-success" role="status">@successMessage</div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="status-note status-error" role="alert">@errorMessage</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
